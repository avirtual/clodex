{
  "name": "clodex-team-hand",
  "spawnerHint": "off",
  "type": "claude",
  "cwd": "${TEAM_ROOT}",
  "proxy": null,
  "agents": [],
  "execCommands": [
    "clodex-team"
  ],
  "intents": [
    "dm",
    "who",
    "context",
    "memory",
    "file",
    "resend",
    "exec",
    "remind",
    "notify-user"
  ],
  "denyBuiltins": [
    "claude-code-guide",
    "statusline-setup"
  ],
  "disabledTools": [
    "LSP",
    "PowerShell",
    "Monitor",
    "WebFetch",
    "WebSearch",
    "TaskCreate",
    "TaskGet",
    "TaskList",
    "TaskUpdate",
    "TaskStop",
    "TaskOutput",
    "TodoWrite",
    "ShareOnboardingGuide",
    "Artifact",
    "ReportFindings",
    "ListMcpResourcesTool",
    "ReadMcpResourceTool",
    "WaitForMcpServers",
    "DesignSync"
  ],
  "disabledSkills": [],
  "injectSkills": [],
  "stripLevel": 2,
  "systemPromptFile": null,
  "appendPromptFiles": [
    "team-project"
  ],
  "env": {
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "60000"
  }
}
