{
  "name": "lead",
  "spawnerHint": "on",
  "type": "claude",
  "cwd": "${TEAM_ROOT}",
  "proxy": null,
  "agents": [],
  "execCommands": [
    "clodex-team",
    "clodex-monitor",
    "clodex-run-tests"
  ],
  "intents": [
    "dm",
    "who",
    "context",
    "memory",
    "file",
    "resend",
    "exec",
    "remind",
    "shout",
    "spawn"
  ],
  "denyBuiltins": [],
  "disabledTools": [],
  "disabledSkills": [
    "*"
  ],
  "extraArgs": ["--model", "claude-opus-5-5[1m]"],
  "injectSkills": [],
  "stripLevel": 2,
  "systemPromptFile": null,
  "appendPromptFiles": [
    "team-project"
  ],
  "env": {
    "CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS": "60000"
  }
}
