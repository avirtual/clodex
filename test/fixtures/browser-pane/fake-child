'use strict';

const fs = require('node:fs');
const path = require('node:path');
const readline = require('node:readline');

const arg = (k) => {
  const hit = process.argv.find((a) => a.startsWith(`--${k}=`));
  return hit ? hit.slice(k.length + 3) : null;
};
const mode = arg('mode') || 'normal';
const frameLog = arg('log');
if (mode === 'ignore-term') process.on('SIGTERM', () => process.stderr.write('ignoring SIGTERM\n'));
const send = (f) => process.stdout.write(JSON.stringify({ cxb: 1, ...f }) + '\n');

const READ = {
  url: 'https://portal.example.com/bills',
  title: 'My Bills',
  doc: 2,
  contentType: 'text/html',
  text: 'My Bills\nAccount ending 5678',
  elements: ['[1] link Home → /', '[2] button View'],
  truncated: false,
  frames: [],
  login: { password: false },
};

let held = null;
let doc = 1;

function answer(f) {
  if (f.op === 'ping' && mode === 'ignore-ping') return undefined;
  if (f.op === 'ping') return send({ id: f.id, ok: true, result: { uptimeMs: 1 } });
  if (f.op === 'shutdown') {
    process.stderr.write('got shutdown\n');
    if (mode === 'ignore-shutdown' || mode === 'ignore-term') return undefined;
    send({ id: f.id, ok: true, result: {} });
    return setImmediate(() => process.exit(0));
  }
  if (mode === 'crash-on-op') { process.stderr.write('dying\n'); process.exit(3); }
  if (f.op === 'open' && /login/.test(f.args.url)) {
    doc += 1;
    const login = { password: true };
    send({ event: 'state', service: f.service, state: 'held', reason: 'login', seat: f.seat, url: f.args.url, title: 'Sign in', login });
    return send({ id: f.id, ok: true, result: { status: 200, url: f.args.url, title: 'Sign in', doc, idle: { ok: true, ms: 800 }, login,
      held: { reason: 'login', login, url: f.args.url } } });
  }
  if (f.op === 'handback') {
    send({ event: 'state', service: f.service, state: 'idle', reason: null, handback: true,
      url: 'https://portal.example.com/account', title: 'Account overview', login: { logoutLink: true } });
    return send({ id: f.id, ok: true, result: { state: 'idle' } });
  }
  if (f.op === 'type' && f.args.n === 7) {
    const login = { password: true };
    send({ event: 'state', service: f.service, state: 'held', reason: 'login', seat: f.seat, url: 'https://portal.example.com/login', title: 'Sign in', login });
    return send({ id: f.id, ok: false, code: 'PASSWORD_FIELD',
      error: `[7] is a password field — credentials never pass through agents. The operator has been asked to sign in; emit [agent:browser wait ${f.service}] and end your turn. Do not ask anyone for the password.` });
  }
  if (f.op === 'click') {
    return send({ id: f.id, ok: true, result: { kind: 'button', label: 'View', navigated: false, idle: { ok: true, ms: 1200 },
      url: READ.url, title: READ.title, doc, login: {}, takeover: false } });
  }
  if (f.op === 'open' && /policy-echo/.test(f.args.url)) {
    return send({ id: f.id, ok: true, result: { status: 200, url: f.args.url, title: JSON.stringify(f.args.policy), doc,
      idle: { ok: true, ms: 1 }, login: {} } });
  }
  if (f.op === 'open' && /opnav/.test(f.args.url)) {
    send({ event: 'state', service: f.service, state: 'idle', reason: null, url: f.args.url, title: 'Nav' });
    send({ id: f.id, ok: true, result: { status: 200, url: f.args.url, title: 'Nav', doc, idle: { ok: true, ms: 1 }, login: {} } });
    for (const u of ['https://portal.example.com/typed', 'https://portal.example.com/second']) {
      send({ event: 'operator-nav', service: f.service, url: u, title: 'Typed page' });
    }
    return send({ event: 'denied', service: f.service, url: 'https://bad.example.com/', pattern: 'bad.example.com', list: 'global', by: 'page' });
  }
  if (f.op === 'policy') {
    send({ event: 'operator-nav', service: f.service, url: 'https://portal.example.com/after-release', title: JSON.stringify(f.args.policy) });
    return send({ id: f.id, ok: true, result: { open: true } });
  }
  if (f.op === 'open') {
    doc += 1;
    if (/drive/.test(f.args.url)) send({ event: 'state', service: f.service, state: 'driving', reason: null, seat: f.seat, url: f.args.url, title: '' });
    return send({ id: f.id, ok: true, result: { status: 200, url: f.args.url, title: 'Fixture ' + f.service, doc,
      idle: { ok: true, ms: 1200 }, login: { password: /login/.test(f.args.url), logoutLink: /home/.test(f.args.url) } } });
  }
  if (f.op === 'read') return send({ id: f.id, ok: true, result: { ...READ, doc } });
  if (f.op === 'download') {
    const url = String(f.args.url || '');
    const html = /expired/.test(url);
    const name = f.args.as || (html ? 'bill.pdf' : 'statement.pdf');
    const file = /escape/.test(url) ? path.join(f.args.dir, '..', 'escaped.pdf') : path.join(f.args.dir, name);
    const body = html ? '<!DOCTYPE html><title>Sign in</title>' : '%PDF-1.4 fake';
    fs.mkdirSync(path.dirname(file), { recursive: true });
    fs.writeFileSync(file, body);
    return send({ id: f.id, ok: true, result: { file, bytes: body.length, mime: html ? 'text/html' : 'application/pdf',
      magic: html ? 'html' : 'pdf', ms: 800, url: READ.url, title: READ.title, doc, login: {}, takeover: false } });
  }
  if (f.op === 'screenshot') {
    return send({ id: f.id, ok: true, result: { jpeg: Buffer.from('fake-jpeg').toString('base64'), width: 1280, height: 900, fallback: false } });
  }
  if (f.op === 'forget') return send({ id: f.id, ok: true, result: { forgotten: f.service } });
  if (f.op === 'echo') return send({ id: f.id, ok: true, result: { echo: f.args.v, pid: process.pid } });
  return send({ id: f.id, ok: false, code: 'INTERNAL', error: `unknown op ${f.op}` });
}

const rl = readline.createInterface({ input: process.stdin });
rl.on('line', (line) => {
  let f;
  try { f = JSON.parse(line); } catch { return; }
  if (frameLog && f.op !== 'shutdown' && f.op !== 'ping') fs.appendFileSync(frameLog, `${f.op}\n`);
  if (mode === 'out-of-order' && f.op === 'echo' && f.args.hold) { held = f; return; }
  answer(f);
  if (held && held !== f) { const h = held; held = null; answer(h); }
});
rl.on('close', () => { if (mode !== 'ignore-shutdown' && mode !== 'ignore-term') process.exit(0); });


if (mode === 'noisy') process.stdout.write('hello from a library\n{"not":"a frame"}\n');
if (mode !== 'no-ready') send({ event: 'ready', proto: 1, electron: 'fake', pid: process.pid });
