#!/bin/bash
set -euo pipefail

WORK="${CLODEX_SUITE_WORK:-/var/lib/clodex-suite}"
SUITE_USER="${CLODEX_SUITE_USER:-clodex-suite}"
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

die() { echo "clodex-suite-exec: $*" >&2; exit 2; }

[ -d "$WORK" ] || die "work root $WORK does not exist"
WORK="$(cd "$WORK" && pwd -P)"

no_dots() {
  case "/${1#/}/" in
    */../*|*/./*|*//*) return 1 ;;
  esac
  return 0
}

job_path() {
  local p="$1" name
  no_dots "$p" || die "refusing $p: not a plain path"
  case "$p" in
    "$WORK"/jobs/*) ;;
    *) die "refusing $p: outside $WORK/jobs" ;;
  esac
  name="${p#"$WORK"/jobs/}"
  [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$ ]] || die "refusing $p: not a job directory"
  [ ! -L "$p" ] || die "refusing $p: a symlink"
  printf '%s' "$p"
}

entry_path() {
  local p="$1" rest
  no_dots "$p" || die "refusing $p: not a plain path"
  case "$p" in
    "$WORK"/deps/*/*) ;;
    *) die "refusing $p: outside $WORK/deps" ;;
  esac
  rest="${p#"$WORK"/deps/}"
  [[ "$rest" =~ ^[0-9a-f]{40,64}/[0-9a-f]{64}$ ]] || die "refusing $p: not a deps entry"
  [ -d "$p" ] && [ ! -L "$p" ] || die "refusing $p: not a directory"
  printf '%s' "$p"
}

mirror_path() {
  local p="$1" name
  no_dots "$p" || die "refusing $p: not a plain path"
  case "$p" in
    "$WORK"/mirrors/*) ;;
    *) die "refusing $p: outside $WORK/mirrors" ;;
  esac
  name="${p#"$WORK"/mirrors/}"
  [[ "$name" =~ ^[0-9a-f]{40}([0-9a-f]{24})?\.git$ ]] || die "refusing $p: not a mirror"
  [ -d "$p" ] && [ ! -L "$p" ] || die "refusing $p: not a directory"
  printf '%s' "$p"
}

close_mirrors() {
  local m
  for m in "$WORK"/mirrors/*.git; do
    [ -d "$m" ] && [ ! -L "$m" ] || continue
    chmod 0700 "$m"
  done
}

close_deps() {
  local e
  for e in "$WORK"/deps/*/*; do
    [ -d "$e" ] && [ ! -L "$e" ] || continue
    chmod 0700 "$e"
  done
}

rel_path() {
  local rel="$1" base="$2" cur
  no_dots "$rel" || die "refusing $rel: not a plain relative path"
  case "$rel" in
    /*|-*|'') die "refusing $rel: not a relative path" ;;
  esac
  cur="$base"
  IFS=/ read -ra parts <<< "$rel"
  for part in "${parts[@]}"; do
    cur="$cur/$part"
    [ ! -L "$cur" ] || die "refusing $rel: $cur is a symlink"
  done
}

kill_suite() {
  setpriv --reuid="$SUITE_USER" --regid="$SUITE_USER" --clear-groups kill -KILL -1 || true
}

verb="${1:-}"
[ $# -ge 2 ] || die "usage: clodex-suite-exec prepare|run|seal|reap <job> ..."
shift
job="$(job_path "$1")"
shift

case "$verb" in
  prepare)
    [ $# -ge 1 ] || die "refusing prepare without the job's mirror"
    mirror="$(mirror_path "$1")"
    shift
    entry=""
    if [ $# -ge 1 ]; then entry="$(entry_path "$1")"; fi
    [ -d "$job" ] || die "no job directory $job"
    for d in "$job/tree" "$job/home" "$job/tmp"; do
      [ -d "$d" ] && [ ! -L "$d" ] || die "refusing $d: not a directory"
    done
    chown -R "$SUITE_USER:$SUITE_USER" "$job/tree" "$job/home" "$job/tmp"
    close_mirrors
    chgrp "$SUITE_USER" "$mirror"
    chmod 0750 "$mirror"
    close_deps
    if [ -n "$entry" ]; then
      chgrp "$SUITE_USER" "$entry"
      chmod 0750 "$entry"
    fi
    ;;
  run)
    envs=()
    while [ $# -gt 0 ] && [ "$1" != "--" ]; do
      [[ "$1" =~ ^[A-Z_][A-Z0-9_]*= ]] || die "refusing env entry $1"
      envs+=("$1")
      shift
    done
    [ "${1:-}" = "--" ] || die "run needs -- before the command"
    shift
    [ $# -ge 1 ] || die "run needs a command"
    cd "$job/tree"
    exec setpriv --reuid="$SUITE_USER" --regid="$SUITE_USER" --clear-groups --no-new-privs \
      env -i ${envs[@]+"${envs[@]}"} "$@"
    ;;
  seal)
    [ $# -ge 1 ] || die "seal needs an entry"
    entry="$(entry_path "$1")"
    shift
    kill_suite
    [ -d "$job/tree" ] && [ ! -L "$job/tree" ] || die "refusing $job/tree: not a directory"
    owner="${SUDO_UID:-$(id -u)}:${SUDO_GID:-$(id -g)}"
    for rel in "$@"; do
      rel_path "$rel" "$job/tree"
      rel_path "$rel" "$entry"
      src="$job/tree/$rel"
      [ -e "$src" ] || continue
      mkdir -p "$(dirname "$entry/$rel")"
      mv "$src" "$entry/$rel"
      ln -s "$entry/$rel" "$src"
      chown -h "$SUITE_USER:$SUITE_USER" "$src"
    done
    chown -R "$owner" "$entry"
    chmod -R a-w,a+rX "$entry"
    chgrp "$SUITE_USER" "$entry"
    chmod 0750 "$entry"
    ;;
  reap)
    entry=""
    if [ $# -ge 1 ]; then entry="$(entry_path "$1")"; fi
    kill_suite
    close_mirrors
    if [ -n "$entry" ]; then chmod 0700 "$entry"; fi
    rm -rf "$job"
    ;;
  *)
    die "unknown verb $verb"
    ;;
esac
